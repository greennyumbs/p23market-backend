// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  ADMIN
}

enum TransactionType {
  TRANSFER
  BORROW
  REPAY
  ARENA
  ARENA_ESCROW
  ARENA_REFUND
}

enum RoomStatus {
  OPEN
  RESOLVED
  CANCELLED
}

enum InvoiceStatus {
  PENDING   @map("pending")
  PAID      @map("paid")
  CANCELLED @map("cancelled")
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  passwordHash  String
  displayName   String
  avatarIndex   Int      @default(0)
  role          Role     @default(PLAYER)
  
  coin          Int      @default(0)
  bankDebt      Int      @default(0)
  
  // Relations
  sentTransfers     Transaction[] @relation("SentTransactions")
  receivedTransfers Transaction[] @relation("ReceivedTransactions")
  
  settlementsRun    Settlement[]  @relation("SettlementsRun")
  settlementSnapshots SettlementSnapshot[]

  ownedRooms        ArenaRoom[]   @relation("RoomOwner")
  matchesAsOwner    ArenaMatch[]  @relation("MatchOwner")
  matchesAsChallenger ArenaMatch[] @relation("MatchChallenger")
  matchesWon        ArenaMatch[]  @relation("MatchWinner")

  createdInvoices   Invoice[]     @relation("InvoiceCreator")
  assignedInvoices  Invoice[]     @relation("InvoicePayer")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("users")
  @@index([role])
}

model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  
  fromUserId  String?
  fromUser    User?           @relation("SentTransactions", fields: [fromUserId], references: [id])
  
  toUserId    String?
  toUser      User?           @relation("ReceivedTransactions", fields: [toUserId], references: [id])
  
  amount      Int
  note        String?
  
  createdAt   DateTime        @default(now())

  @@map("transactions")
  @@index([type])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([createdAt])
}

model Settlement {
  id            String               @id @default(cuid())
  createdAt     DateTime             @default(now())
  
  runByUserId   String
  runByUser     User                 @relation("SettlementsRun", fields: [runByUserId], references: [id])
  
  snapshots     SettlementSnapshot[]

  @@map("settlements")
  @@index([createdAt])
}

model SettlementSnapshot {
  id            String     @id @default(cuid())
  settlementId  String
  settlement    Settlement @relation(fields: [settlementId], references: [id])
  
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  
  coin          Int
  bankDebt      Int
  net           Int

  @@map("settlement_snapshots")
  @@index([settlementId])
  @@index([userId])
}

model ArenaRoom {
  id          String     @id @default(cuid())
  name        String?
  ownerId     String
  owner       User       @relation("RoomOwner", fields: [ownerId], references: [id])
  
  amount      Int
  choice      String     
  status      RoomStatus @default(OPEN)
  
  match       ArenaMatch?
  
  createdAt   DateTime   @default(now())

  @@map("arena_rooms")
  @@index([status])
  @@index([ownerId])
  @@index([createdAt])
}

model ArenaMatch {
  id                String   @id @default(cuid())
  roomId            String   @unique
  room              ArenaRoom @relation(fields: [roomId], references: [id])
  
  ownerId           String
  owner             User     @relation("MatchOwner", fields: [ownerId], references: [id])
  
  challengerId      String
  challenger        User     @relation("MatchChallenger", fields: [challengerId], references: [id])
  
  amount            Int
  ownerChoice       String
  challengerChoice  String
  
  winnerUserId      String?
  winner            User?    @relation("MatchWinner", fields: [winnerUserId], references: [id])
  
  resolvedAt        DateTime @default(now())

  @@map("arena_matches")
  @@index([ownerId])
  @@index([challengerId])
  @@index([winnerUserId])
  @@index([resolvedAt])
}

model Invoice {
  id                 String        @id @default(cuid())
  createdByUserId    String
  createdByUser      User          @relation("InvoiceCreator", fields: [createdByUserId], references: [id])
  currentPayerUserId String
  currentPayerUser   User          @relation("InvoicePayer", fields: [currentPayerUserId], references: [id])
  amount             Int
  noteLatest         String        @default("")
  status             InvoiceStatus @default(PENDING)
  paidAt             DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("invoices")
  @@index([createdByUserId])
  @@index([currentPayerUserId])
  @@index([status])
  @@index([updatedAt])
}
