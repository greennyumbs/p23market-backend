// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  ADMIN
}

enum TransactionType {
  TRANSFER
  BORROW
  REPAY
  ARENA
  ARENA_ESCROW
  ARENA_REFUND
  TEAM_RPS_VOTE_ESCROW
  TEAM_RPS_VOTE_PAYOUT
  TEAM_RPS_VOTE_REFUND
  MAJORITY_DIE_ESCROW
  MAJORITY_DIE_PAYOUT
  MAJORITY_DIE_REFUND
}

enum RoomStatus {
  OPEN
  RESOLVED
  CANCELLED
}

enum InvoiceStatus {
  PENDING   @map("pending")
  PAID      @map("paid")
  CANCELLED @map("cancelled")
}

enum MiniGameMode {
  TEAM_RPS_VOTE
  MAJORITY_DIE
}

enum MiniGameRoomStatus {
  WAITING
  PLAYING
  FINISHED
  CANCELLED
}

enum TeamSide {
  A
  B
}

enum MiniGameRoundStatus {
  OPEN
  RESOLVED
}

enum RpsChoice {
  ROCK
  PAPER
  SCISSORS
}

enum MajorityDieChoice {
  LEFT
  RIGHT
}

enum MajorityDieResolutionReason {
  MINORITY_SURVIVE
  TIE_REPLAY
  SINGLE_SIDE_REPLAY
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  passwordHash  String
  displayName   String
  avatarIndex   Int      @default(0)
  role          Role     @default(PLAYER)
  
  coin          Int      @default(0)
  bankDebt      Int      @default(0)
  
  // Relations
  sentTransfers     Transaction[] @relation("SentTransactions")
  receivedTransfers Transaction[] @relation("ReceivedTransactions")
  
  settlementsRun    Settlement[]  @relation("SettlementsRun")
  settlementSnapshots SettlementSnapshot[]

  ownedRooms        ArenaRoom[]   @relation("RoomOwner")
  matchesAsOwner    ArenaMatch[]  @relation("MatchOwner")
  matchesAsChallenger ArenaMatch[] @relation("MatchChallenger")
  matchesWon        ArenaMatch[]  @relation("MatchWinner")

  createdInvoices   Invoice[]     @relation("InvoiceCreator")
  assignedInvoices  Invoice[]     @relation("InvoicePayer")
  hostedMiniGameRooms MiniGameRoom[] @relation("MiniGameHost")
  miniGameParticipants MiniGameParticipant[]
  miniGameRoundSubmissions MiniGameRoundSubmission[]
  majorityDieStageSubmissions MajorityDieStageSubmission[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("users")
  @@index([role])
}

model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  
  fromUserId  String?
  fromUser    User?           @relation("SentTransactions", fields: [fromUserId], references: [id])
  
  toUserId    String?
  toUser      User?           @relation("ReceivedTransactions", fields: [toUserId], references: [id])
  
  amount      Int
  note        String?
  
  createdAt   DateTime        @default(now())

  @@map("transactions")
  @@index([type])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([createdAt])
}

model Settlement {
  id            String               @id @default(cuid())
  createdAt     DateTime             @default(now())
  
  runByUserId   String
  runByUser     User                 @relation("SettlementsRun", fields: [runByUserId], references: [id])
  
  snapshots     SettlementSnapshot[]

  @@map("settlements")
  @@index([createdAt])
}

model SettlementSnapshot {
  id            String     @id @default(cuid())
  settlementId  String
  settlement    Settlement @relation(fields: [settlementId], references: [id])
  
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  
  coin          Int
  bankDebt      Int
  net           Int

  @@map("settlement_snapshots")
  @@index([settlementId])
  @@index([userId])
}

model ArenaRoom {
  id          String     @id @default(cuid())
  name        String?
  ownerId     String
  owner       User       @relation("RoomOwner", fields: [ownerId], references: [id])
  
  amount      Int
  choice      String     
  status      RoomStatus @default(OPEN)
  
  match       ArenaMatch?
  
  createdAt   DateTime   @default(now())

  @@map("arena_rooms")
  @@index([status])
  @@index([ownerId])
  @@index([createdAt])
}

model ArenaMatch {
  id                String   @id @default(cuid())
  roomId            String   @unique
  room              ArenaRoom @relation(fields: [roomId], references: [id])
  
  ownerId           String
  owner             User     @relation("MatchOwner", fields: [ownerId], references: [id])
  
  challengerId      String
  challenger        User     @relation("MatchChallenger", fields: [challengerId], references: [id])
  
  amount            Int
  ownerChoice       String
  challengerChoice  String
  
  winnerUserId      String?
  winner            User?    @relation("MatchWinner", fields: [winnerUserId], references: [id])
  
  resolvedAt        DateTime @default(now())

  @@map("arena_matches")
  @@index([ownerId])
  @@index([challengerId])
  @@index([winnerUserId])
  @@index([resolvedAt])
}

model Invoice {
  id                 String        @id @default(cuid())
  createdByUserId    String
  createdByUser      User          @relation("InvoiceCreator", fields: [createdByUserId], references: [id])
  currentPayerUserId String
  currentPayerUser   User          @relation("InvoicePayer", fields: [currentPayerUserId], references: [id])
  amount             Int
  noteLatest         String        @default("")
  status             InvoiceStatus @default(PENDING)
  paidAt             DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("invoices")
  @@index([createdByUserId])
  @@index([currentPayerUserId])
  @@index([status])
  @@index([updatedAt])
}

model MiniGameRoom {
  id            String              @id @default(cuid())
  name          String?
  mode          MiniGameMode
  status        MiniGameRoomStatus  @default(WAITING)
  hostUserId    String
  hostUser      User                @relation("MiniGameHost", fields: [hostUserId], references: [id])
  entryStake    Int
  stake         Int                 @default(0)
  minPlayers    Int                 @default(4)
  maxPlayers    Int                 @default(10)
  stageTimeoutSec Int               @default(15)
  currentRound  Int                 @default(0)
  scoreA        Int                 @default(0)
  scoreB        Int                 @default(0)
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  participants  MiniGameParticipant[]
  rounds        MiniGameRound[]
  majorityDieStages MajorityDieStage[]

  @@map("mini_game_rooms")
  @@index([mode, status])
  @@index([hostUserId])
  @@index([createdAt])
}

model MiniGameParticipant {
  id          String       @id @default(cuid())
  roomId      String
  room        MiniGameRoom @relation(fields: [roomId], references: [id])
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  team        TeamSide?
  alive       Boolean      @default(true)
  joinedAt    DateTime     @default(now())
  leftAt      DateTime?

  submissions MiniGameRoundSubmission[]
  majorityDieSubmissions MajorityDieStageSubmission[]

  @@map("mini_game_participants")
  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@index([team])
}

model MiniGameRound {
  id                String               @id @default(cuid())
  roomId            String
  room              MiniGameRoom         @relation(fields: [roomId], references: [id])
  roundNumber       Int
  status            MiniGameRoundStatus  @default(OPEN)
  inputStartedAt    DateTime
  inputEndsAt       DateTime
  resolvedAt        DateTime?
  teamChoiceA       RpsChoice?
  teamChoiceB       RpsChoice?
  teamTieBreakA     Boolean              @default(false)
  teamTieBreakB     Boolean              @default(false)
  countRockA        Int                  @default(0)
  countPaperA       Int                  @default(0)
  countScissorsA    Int                  @default(0)
  countRockB        Int                  @default(0)
  countPaperB       Int                  @default(0)
  countScissorsB    Int                  @default(0)
  roundWinner       TeamSide?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  submissions       MiniGameRoundSubmission[]

  @@map("mini_game_rounds")
  @@unique([roomId, roundNumber])
  @@index([roomId, status])
}

model MiniGameRoundSubmission {
  id             String               @id @default(cuid())
  roundId        String
  round          MiniGameRound        @relation(fields: [roundId], references: [id])
  participantId  String
  participant    MiniGameParticipant  @relation(fields: [participantId], references: [id])
  userId         String
  user           User                 @relation(fields: [userId], references: [id])
  choice         RpsChoice
  autoPicked     Boolean              @default(false)
  submittedAt    DateTime             @default(now())

  @@map("mini_game_round_submissions")
  @@unique([roundId, participantId])
  @@index([roundId])
  @@index([participantId])
  @@index([userId])
}

model MajorityDieStage {
  id               String                        @id @default(cuid())
  roomId           String
  room             MiniGameRoom                  @relation(fields: [roomId], references: [id])
  stageNumber      Int
  status           MiniGameRoundStatus           @default(OPEN)
  inputStartedAt   DateTime
  inputEndsAt      DateTime
  resolvedAt       DateTime?
  pickLeftCount    Int                           @default(0)
  pickRightCount   Int                           @default(0)
  minoritySide     MajorityDieChoice?
  resolutionReason MajorityDieResolutionReason?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  submissions      MajorityDieStageSubmission[]

  @@map("majority_die_stages")
  @@unique([roomId, stageNumber])
  @@index([roomId, status])
}

model MajorityDieStageSubmission {
  id             String                @id @default(cuid())
  stageId        String
  stage          MajorityDieStage      @relation(fields: [stageId], references: [id])
  participantId  String
  participant    MiniGameParticipant   @relation(fields: [participantId], references: [id])
  userId         String
  user           User                  @relation(fields: [userId], references: [id])
  choice         MajorityDieChoice
  autoPicked     Boolean               @default(false)
  submittedAt    DateTime              @default(now())

  @@map("majority_die_stage_submissions")
  @@unique([stageId, participantId])
  @@index([stageId])
  @@index([participantId])
  @@index([userId])
}
